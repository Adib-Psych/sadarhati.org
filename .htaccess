# Sadar Hati Foundation — situs statis publik
DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType image/jpeg .jpg .JPG .jpeg
  AddType image/png .png .PNG
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0) Halaman Gallery digabung ke Kegiatan (301)
  RewriteRule ^gallery(?:\.html)?/?$ /kegiatan [R=301,L,NC]

  # 1) Redirect permintaan ".html" ke URL bersih (301)
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 2) Petakan URL bersih ke file .html secara internal
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
